<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Helsa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- اسپلش با core-splashscreen: لوگوی برند روی پس‌زمینهٔ کرم برند -->
    <style name="Theme.Helsa.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Helsa</item>
    </style>
</resources>
