{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "verify:production": "bash scripts/verify-production.sh",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "images:regen": "node scripts/regen-image-variants.mjs",
    "env:recovery": "bash scripts/env-recovery.sh",
    "test:unit": "node --import tsx --test tests/unit.test.ts",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "NEXT_OUTPUT_STANDALONE=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:build": "NEXT_OUTPUT_STANDALONE=1 opennextjs-cloudflare build",
    "cf:typegen": "wrangler types",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "cf:build:local": "NEXT_OUTPUT_STANDALONE=1 npm run build && opennextjs-cloudflare build --skipNextBuild",
    "catalog:export": "node scripts/export-fallback-catalog.mjs",
    "qa:e2e": "python3 scripts/qa-e2e.py",
    "qa:authz": "python3 scripts/authz-sweep.py",
    "qa:tokens": "node scripts/qa-mint-tokens.mjs",
    "images:check": "node scripts/prune-image-variants.mjs --check",
    "images:prune": "node scripts/prune-image-variants.mjs --fix",
    "db:migrate:prod": "bash scripts/migrate-production.sh"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.38.0",
    "next": "^16.4.2",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "tsx": "^4.23.13",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.30",
    "sharp": "^0.35.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=20.9 <23"
  }
}
