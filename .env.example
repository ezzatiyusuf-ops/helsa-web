# ==========================================================
# HELSA IRANIAN — environment configuration (example)
# Copy to `.env` (local). در Cloudflare: `wrangler secret put NAME` یا Dashboard → Workers → Settings → Variables.
# هرگز مقدار واقعی را commit نکنید؛ این فایل فقط نمونه است.
#
# ── Cloudflare Workers (OpenNext) ──
# بیلد CF: npm run cf:build  (داخلش NEXT_OUTPUT_STANDALONE=1 ست می‌شود؛ دستی نگذارید)
# `next start` محلی با output:standalone ناسازگار است — برای همین standalone مشروط است.
# در Workers متغیرها را wrangler secret/Dashboard بگذارید؛ DATABASE_URL از env خوانده می‌شود.
# اتصال Postgres از Worker: TCP با nodejs_compat (pg) — Hyperdrive اختیاری برای کش/pooling.
# ==========================================================

# ──────────────────────────────────────────────────────────
# ۱) دیتابیس (الزامی برای پروداکشن)
# ──────────────────────────────────────────────────────────
# PostgreSQL میزبانی‌شده: Supabase / Neon / Railway (connection string پنل).
# در محیط میزبانی (Cloudflare) اتصال به localhost به‌طور خودکار رد می‌شود.
# SSL برای هاست‌های غیرمحلی خودکار فعال است.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# اختیاری: verify (تأیید سختگیرانهٔ گواهی) | disable (بدون SSL)
DATABASE_SSL=

# ──────────────────────────────────────────────────────────
# ۲) سایت (الزامی برای پروداکشن)
# ──────────────────────────────────────────────────────────
# آدرس عمومی مطلق — canonical/sitemap/robots/JSON-LD/CSRF.
# دامنهٔ نهایی را بگذارید (نه دامنهٔ تست موقت).
NEXT_PUBLIC_SITE_URL=https://helsairanian.ir
# نام مستعار پذیرفته‌شده (اختیاری): NEXTAUTH_URL=… (اگر SITE_URL تنظیم باشد لازم نیست)
NEXTAUTH_URL=

# ──────────────────────────────────────────────────────────
# ۳) نشست/احراز هویت (الزامی برای لاگین)
# ──────────────────────────────────────────────────────────
# راز امضای کوکی نشست (jose HS256) — حداقل ۳۲ نویسه.
# ساخت: openssl rand -base64 48
# نام‌های مستعار پذیرفته‌شده (اختیاری): NEXTAUTH_SECRET یا JWT_SECRET
AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars
NEXTAUTH_SECRET=
JWT_SECRET=
# ایمیل(ها)ی مجاز پنل ادمین — با کاما جدا شوند
ADMIN_EMAILS=owner@example.com

# ──────────────────────────────────────────────────────────
# ۴) OAuth (اختیاری)
# ──────────────────────────────────────────────────────────
# Google: redirect URI = {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: redirect URI = {NEXT_PUBLIC_SITE_URL}/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ──────────────────────────────────────────────────────────
# ۵) پرداخت (بازار ایران)
# ──────────────────────────────────────────────────────────
# ⚠️ PAYMENTS_SANDBOX فقط برای توسعه؛ در پروداکشن حتماً 0 یا حذف
PAYMENTS_SANDBOX=0

# ──────────────────────────────────────────────────────────
# ۵-ب) کارت‌به‌کارت — مقصد واریز (تنها محل تعریف؛ هرگز در کد/کامپوننت تکرار نشود)
# ──────────────────────────────────────────────────────────
# اگر خالی بمانند، مقادیر تأییدشدهٔ مالک از src/config/card-transfer.ts استفاده می‌شود.
# فرمت شماره: دقیقاً ۱۶ رقم بدون فاصله. CARD_TRANSFER_ENABLED=0 برای خاموش‌کردن موقت.
CARD_TRANSFER_NUMBER=
CARD_TRANSFER_HOLDER=
CARD_TRANSFER_BANK=
CARD_TRANSFER_ENABLED=1
# سقف حجم فایل رسید (بایت) — پیش‌فرض ۵ مگابایت
RECEIPT_MAX_BYTES=5242880

# درگاه شاپرکی — زرین‌پال v4 (پرداخت آنلاین)
GATEWAY_PROVIDER=zarinpal
GATEWAY_API_KEY=
GATEWAY_SANDBOX=0
GATEWAY_CURRENCY=IRT
# اسنپ‌پی (اقساطی)
SNAP_PAY_API_KEY=
SNAP_PAY_BASE=https://api.snappay.ir
SNAP_PAY_MIN=500000
SNAP_PAY_MAX=50000000
# دیجی‌پی (قرارداد رسمی mydigipay.com — oauth + tickets/business + purchases/verify)
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_BASE=https://api.mydigipay.com/digipay/api
DIGIPAY_VERSION=2022-02-02
DIGIPAY_MAX=20000000
# پرداخت در محل
COD_ENABLED=1
COD_PROVINCES=تهران
COD_MAX_AMOUNT=10000000
# احراز هویت پرداخت (کد ملی + موبایل)
IDENTITY_PROVIDER=simulation
IDENTITY_REQUIRED=1

# ──────────────────────────────────────────────────────────
# ۶) اینستاگرام (اختیاری — فید زندهٔ Graph API)
# ──────────────────────────────────────────────────────────
# بدون این‌ها بخش اینستاگرام از «پست‌های منتخب» (پنل ادمین) پر می‌شود.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0

# ──────────────────────────────────────────────────────────
# ۷) پیامک/ایمیل (اختیاری — فعلاً بدون سرویس، حالت دمو)
# ──────────────────────────────────────────────────────────
SMS_PROVIDER=
SMS_API_KEY=
# رزرو برای آینده — در کد فعلاً استفاده نمی‌شوند (فعال‌سازی = فیچر جدید):
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Stripe به دلیل تحریم‌های منطقه‌ای استفاده نمی‌شود (درگاه‌های ایرانی بالا)

# ──────────────────────────────────────────────────────────
# ۸) پرچم‌های توسعه — ⚠️ هرگز در پروداکشن
# ──────────────────────────────────────────────────────────
# بازگرداندن کد OTP در پاسخ API (فقط dev بدون SMS)
ALLOW_DEV_OTP_HINT=
# کوکی Secure حتی خارج از NODE_ENV=production
FORCE_SECURE_COOKIES=

# ایندکس موتورهای جستجو فقط در production فعال است (بریف ۱.۵) — در محیط توسعه خالی بماند
# ALLOW_INDEXING=1

# 🔴 فقط محیط تست/استیجینگ: کد OTP در پاسخ API برمی‌گردد (وقتی SMS پیکربندی نشده).
# در تولید هرگز ست نشود — scripts/verify-production.sh وجودش را FAIL می‌کند.
# OTP_TEST_HINT=1

# ──────────────────────────────────────────────────────────
# ۹) اپ اندروید — تأیید App Links (فاز ۸)
# ──────────────────────────────────────────────────────────
# اثر انگشت SHA-256 گواهی امضا برای /.well-known/assetlinks.json
# چند اثر انگشت (debug/release/Play App Signing) را با کاما جدا کنید.
# گرفتن مقدار: keytool -list -v -keystore release.keystore | grep SHA256
# بدون این مقدار، مسیر ۴۰۴ می‌دهد و اندروید لینک‌ها را به اپ باز نمی‌کند.
ANDROID_APP_SHA256=
ANDROID_APP_PACKAGE=ir.helsairanian.app
